      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ account: %2$@. Tap to change."
          }
        }
      }
    },
    "%@: %@" : {
      "comment" : "An accessibility label that combines the label and value of the detail row.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
    "%@%@" : {
      "comment" : "A text displaying the amount of a transaction, prefixed with a plus or minus sign based on whether it's an income or expense. The value is formatted as currency.",
